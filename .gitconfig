[core]
  editor = nvim
  autoCRLF = false
  excludesfile = ~/.config/git/ignore

[color]
  status = auto
  diff = auto
  branch = auto
  interactive = auto
  grep = auto
  ui = auto

[alias]
  st = status
  ci = commit
  ch = checkout
  ca = commit -a
  cm = commit -m
  br = branch
  ba = branch -a
  d = diff
  df = "!git hist | peco | awk '{print $2}' | xargs -I {} git diff {}^ {}"
  ps = "!git push origin $(git rev-parse --abbrev-ref HEAD)"
  lr = "!git log --graph --oneline remotes/origin/$(git rev-parse --abbrev-ref HEAD)"
  hist = log --pretty=format:\"%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%C(reset)\" --graph --date=relative --decorate --all
  pl = "!git pull origin $(git rev-parse --abbrev-ref HEAD)"
  open = "!hub browse"
  find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 | uniq -f1 -d | sort -n | tail -1 | cut -f2'"
  show-merge = "!sh -c 'merge=$(git find-merge $0 $1) && [ -n \"$merge\" ] && git show $merge'"

[commit]
    template = ~/.commit_template

[push]
  default = matching

[pull]
  rebase = false

[hub]
  protocol = https

[user]
  name = posaune0423
	email = posaune0423@users.noreply.github.com
[init]
  defaultBranch = main
[wt]
  # git-wt: keep worktrees under the repository root, not under ghq root, so a
  # stray delete cannot reach the repository's own .git directory.
  # Remove worktrees with `git wt -d <branch>`; it runs the safety checks and
  # prunes the worktree metadata. `git wt -D` and `rm -rf .worktrees` are
  # destructive: they discard uncommitted work and leave stale metadata behind.
  basedir = .worktrees
  # Carry the small gitignored files a fresh worktree needs into it. Real copies
  # (not symlinks) keep the worktree clean for `git wt -d`; a symlinked
  # directory reads as untracked and makes safe deletion refuse forever.
  copy = CLAUDE.local.md
  copy = .env
  copy = .env.local
  copy = .claude/settings.local.json
  # Share node_modules instead of copying it, so creating a worktree stays fast.
  # Safe only because the global ignore lists a bare `node_modules`, which also
  # matches the symlink and therefore keeps `git wt -d` working.
  copy = node_modules
  symlink = node_modules
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[include]
	path = ~/.gitconfig.local
