fish_variables
.config/fish/fish_variables
.config/fish/completions.local/
.config/fish/conf.d/99_local_secrets.fish
# Machine-local Fish config, such as work-only commands.
.config/fish/conf.d/*.local.fish

.nvimlog

.agents/memory

# Raycast-owned state under ~/.config/raycast. Only script-commands/ and
# defaults.conf are tracked; config.json holds access tokens.
.config/raycast/config.json
.config/raycast/extensions/
.config/raycast/ai/
# Raycast "Export" output: encrypted blob that still carries the access token.
*.rayconfig

# Superwhisper: private vocabulary and the settings folder built from it by
# scripts/superwhisper-settings.sh. Only settings.json and modes/ are tracked.
.config/superwhisper/settings.local.json
.config/superwhisper/settings/
# Last synced modes, last build, and the push/pull lock.
.config/superwhisper/.state/
